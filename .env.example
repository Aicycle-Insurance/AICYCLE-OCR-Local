# Mọi biến đều optional: không set thì dùng default trong config.yaml

# OCR engine: chandra | dots_mocr
OCR_ENGINE=chandra
OCR_DPI=200
OCR_MAX_CONCURRENCY=8
OCR_RETRY_MAX_ATTEMPTS=3
OCR_RETRY_INITIAL_DELAY=2.0
OCR_RETRY_MAX_DELAY=30.0

CHANDRA_BASE_URL=https://demo-llm-gateway.aicycle.ai/ocr/v1
CHANDRA_MODEL=chandra
DOTS_MOCR_BASE_URL=http://localhost:8001/v1
DOTS_MOCR_MODEL=rednote-hilab/dots.mocr

# LLM extraction
LLM_BASE_URL=https://demo-llm-gateway.aicycle.ai/llm/v1
LLM_MODEL=nvidia/Gemma-4-26B-A4B-NVFP4
LLM_MAX_TOKENS=16384
LLM_MAX_CONCURRENT_EXTRACTIONS=3
LLM_TABLE_CHUNK_PAGES=2

# Langfuse
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Label Studio (scripts/ls_ocr.py, scripts/ls_extract.py): Personal Access Token
LABEL_STUDIO_API_KEY=

# Docker compose: cổng API và địa chỉ vLLM nhìn từ trong container
PORT=9006
CHANDRA_BASE_URL_DOCKER=http://host.docker.internal:8000/v1
LLM_BASE_URL_DOCKER=http://host.docker.internal:10100/v1